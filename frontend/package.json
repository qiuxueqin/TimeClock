{
  "name": "timeclock-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "学习打卡系统 V1.0 前端 SPA（React 19 + Vite 6 + TS 5）",
  "type": "module",
  "scripts": {
    "dev": "vite",
